---
import { nav } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer class="site">
  <div class="wrap">
    <div class="foot">
      <a class="brand" href="/"><img src="/img/logo-white.png" alt="Final Mile Providers LLC" style="height:40px;opacity:.9" /></a>
      <div class="fmenu">
        {nav.map(i => <a href={i.href}>{i.label}</a>)}
        <a href="/privacy">Privacy Policy</a>
      </div>
    </div>
    <div class="cr">
      <span>© 2023–{year} Final Mile Providers LLC. All rights reserved.</span>
      <span>Delivering excellence, every mile.</span>
    </div>
  </div>
</footer>
