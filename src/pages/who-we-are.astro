---
import Base from '../layouts/Base.astro';
const values = [
  ["Experienced leadership","Partners have held senior roles at globally recognized logistics companies.","experienced-leadership.webp"],
  ["Customized solutions","Tailored logistics services built around each client's specific needs.","customized-solutions.webp"],
  ["Core values","Integrity, innovation, and customer-centricity are the foundation of the business.","core-values.webp"],
  ["Technology-driven","We leverage advanced technology for efficient, transparent operations.","technology-driven.webp"],
  ["Growth-oriented","We continually expand our reach, coverage, and capabilities.","growth-oriented.webp"],
  ["Talent-focused","We invest in attracting, developing, and retaining top talent.","talent-focus.webp"]
];
---
<Base title="Who we are | Final Mile Providers LLC">
  <section class="page-hero"><div class="wrap">
    <span class="eyebrow" style="color:var(--steel-lt)">Who we are</span>
    <h1>Logistics experts, end to end</h1>
    <p>A team of logistics experts dedicated to exceptional service and deep expertise in final-mile delivery. As a non-asset partner, we provide customized, cost-effective solutions that meet each client's unique needs.</p>
  </div></section>

  <section><div class="wrap"><div class="split">
    <div class="prose">
      <h2 class="disp" style="text-transform:uppercase;font-size:clamp(24px,3vw,34px);margin-bottom:18px">Our mission</h2>
      <p>To revolutionize the final-mile experience with fast, flexible, reliable service that exceeds expectations — building long-term relationships based on trust, transparency, and a commitment to excellence.</p>
      <h2 class="disp" style="text-transform:uppercase;font-size:clamp(24px,3vw,34px);margin:26px 0 18px">Our team</h2>
      <p>Our team is comprised of experienced logistics professionals passionate about delivering exceptional service. From operations to customer service, every member is dedicated to a seamless, stress-free experience for our clients.</p>
    </div>
    <div class="photo"><img src="/img/who-we-are-team.jpg"
     alt="The Final Mile Providers team"
      loading="lazy" /></div>
  </div></div></section>

  <section class="band"><div class="wrap">
    <div class="sec-head"><span class="eyebrow">Our values</span><h2 class="disp">What we stand for</h2></div>
    <div class="values">
      {values.map(([t,d,img]) => (
        <div class="value has-img">
          <img src={`/img/${img}`} alt={t} loading="lazy" width="640" height="640" />
          <h3>{t}</h3>
          <p>{d}</p>
        </div>
      ))}
    </div>
  </div></section>

  <style>
    .value.has-img img{
      width:100%;height:auto;display:block;
      aspect-ratio:1/1;object-fit:cover;
      border-radius:4px;margin-bottom:16px;
    }
    .value.has-img{
      opacity:0;transform:translateY(24px);
      transition:opacity .7s ease,transform .7s ease;
    }
    .value.has-img.visible{opacity:1;transform:none}
    @media (prefers-reduced-motion:reduce){
      .value.has-img{opacity:1;transform:none;transition:none}
    }
  </style>

  <script is:inline>
    (function(){
      var items=document.querySelectorAll('.value.has-img');
      if(!items.length)return;
      if(!('IntersectionObserver' in window)){
        items.forEach(function(el){el.classList.add('visible')});return;
      }
      var io=new IntersectionObserver(function(es){
        es.forEach(function(e,i){
          if(e.isIntersecting){
            setTimeout(function(){e.target.classList.add('visible')},i*110);
            io.unobserve(e.target);
          }
        });
      },{threshold:.15});
      items.forEach(function(el){io.observe(el)});
    })();
  </script>
</Base>