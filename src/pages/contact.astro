---
import Base from '../layouts/Base.astro';
import { contact, WEB3FORMS_KEY } from '../data/site.js';
---
<Base title="Contact | Final Mile Providers LLC">
  <section class="contact-sec"><div class="wrap"><div class="contact-grid">
    <div class="cinfo">
      <span class="eyebrow">Contact</span>
      <h2 class="disp">Let's move your last mile</h2>
      <div class="cline"><div class="k">Address</div><span>{contact.addressLine1}<br />{contact.addressLine2}</span></div>
      <div class="cline"><div class="k">Email</div><a href={`mailto:${contact.email}`}>{contact.email}</a></div>
      <div class="cline"><div class="k">Phone</div><a href={contact.phoneHref}>{contact.phoneDisplay}</a></div>
      <div class="cline"><div class="k">WhatsApp</div><a href={contact.whatsapp} target="_blank" rel="noopener">Chat with us</a></div>
      <div class="cline"><div class="k">Contact</div><span>{contact.person}</span></div>
      <div class="social">
        <a href={contact.instagram} target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s0 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58 0-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.2 15.58 2.2 15.2 2.2 12s0-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.15 0-3.5 0-4.74.07-.9.04-1.38.19-1.7.31-.43.17-.74.37-1.06.69-.32.32-.52.63-.69 1.06-.12.32-.27.8-.31 1.7C3.13 8.5 3.13 8.85 3.13 12s0 3.5.07 4.74c.04.9.19 1.38.31 1.7.17.43.37.74.69 1.06.32.32.63.52 1.06.69.32.12.8.27 1.7.31 1.24.07 1.59.07 4.74.07s3.5 0 4.74-.07c.9-.04 1.38-.19 1.7-.31.43-.17.74-.37 1.06-.69.32-.32.52-.63.69-1.06.12-.32.27-.8.31-1.7.07-1.24.07-1.59.07-4.74s0-3.5-.07-4.74c-.04-.9-.19-1.38-.31-1.7a2.85 2.85 0 0 0-.69-1.06 2.85 2.85 0 0 0-1.06-.69c-.32-.12-.8-.27-1.7-.31C15.5 4 15.15 4 12 4Zm0 3.06A4.94 4.94 0 1 1 12 16.94 4.94 4.94 0 0 1 12 7.06Zm0 1.8A3.14 3.14 0 1 0 12 15.14 3.14 3.14 0 0 0 12 8.86Zm5.14-2.02a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z"/></svg>
        </a>
        <a href={contact.facebook} target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 22v-8.5h2.86l.43-3.32H13.5V8.06c0-.96.27-1.62 1.65-1.62h1.76V3.47c-.3-.04-1.35-.13-2.56-.13-2.53 0-4.27 1.55-4.27 4.39v2.45H7.2v3.32h2.88V22h3.42Z"/></svg>
        </a>
        <a href={contact.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 14.38c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35ZM12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.44 9.44 0 1 1 8 4.42Zm5.6-15.04A11.24 11.24 0 0 0 2.06 20.9L.5 23.5l4.28-1.12a11.2 11.2 0 0 0 5.37 1.37h.01A11.24 11.24 0 0 0 17.65 6.46Z"/></svg>
        </a>
      </div>
    </div>
    <form id="contactForm" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
      <input type="hidden" name="subject" value="New inquiry from finalmileproviders.com" />
      <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />
      <div class="f-row">
        <div><label for="name">Name</label><input id="name" name="name" required /></div>
        <div><label for="phone">Phone</label><input id="phone" name="phone" type="tel" /></div>
      </div>
      <div class="f-row">
        <div><label for="email">Email</label><input id="email" name="email" type="email" required /></div>
        <div><label for="company">Company</label><input id="company" name="company" /></div>
      </div>
      <label for="subject_line">Subject</label><input id="subject_line" name="subject_line" />
      <label for="message">Message</label><textarea id="message" name="message" rows="4" required></textarea>
      <button id="contactSubmit" class="btn btn-red" type="submit">Send inquiry</button>
      <p class="note" id="formResult">We respond to all inquiries within one business day.</p>
    </form>
  </div></div></section>
  <script is:inline>
  (function () {
    var form = document.getElementById('contactForm');
    if (!form) return;
    var result = document.getElementById('formResult');
    var btn = document.getElementById('contactSubmit');
    var defaultNote = result.textContent;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      btn.disabled = true;
      result.textContent = 'Sending...';

      var data = Object.fromEntries(new FormData(form));

      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data)
      })
        .then(function (res) { return res.json(); })
        .then(function (json) {
          if (json.success) {
            result.textContent = 'Thank you. We received your inquiry and will respond within one business day.';
            form.reset();
          } else {
            result.textContent = 'Something went wrong. Please email sales@finalmileproviders.com directly.';
            btn.disabled = false;
          }
        })
        .catch(function () {
          result.textContent = 'Something went wrong. Please email sales@finalmileproviders.com directly.';
          btn.disabled = false;
        });
    });
  })();
</script>
</Base>
